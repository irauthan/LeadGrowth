# ==========================================
# LeadGrowth - Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Root, IDE & Editor Configurations
# ------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln.docstates
*.user
*.userosscache
*.swp
*~
.DS_Store
Thumbs.db
.vs/

# Antigravity & Agent Temp Artifacts
.agents/
.gemini/
antigravity-ide/
scratch/

# ------------------------------------------
# Environment & Secrets Configuration (CRITICAL)
# ------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example

# Frontend env files
frontend/.env
frontend/.env.*
!frontend/.env.example

# Backend env files
backend/.env
backend/.env.*
!backend/.env.example

# Keys, Certificates & Tokens
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.pkcs12
secrets.json
appsettings.secrets.json

# ------------------------------------------
# .NET 10 / C# Backend (backend-dotnet)
# ------------------------------------------
**/bin/
**/obj/
backend-dotnet/bin/
backend-dotnet/obj/
backend-dotnet/publish/
backend-dotnet/logs/
backend-dotnet/TestResults/

# Protect all appsettings with real secrets
backend-dotnet/appsettings*.json
!backend-dotnet/appsettings.example.json

# ------------------------------------------
# User Uploads & Media (Avatars, Attachments)
# ------------------------------------------
backend-dotnet/wwwroot/uploads/*
!backend-dotnet/wwwroot/uploads/.gitkeep
backend-dotnet/wwwroot/uploads/avatars/*
!backend-dotnet/wwwroot/uploads/avatars/.gitkeep
wwwroot/uploads/*
!wwwroot/uploads/.gitkeep

# ------------------------------------------
# Backend (Java Spring Boot & Maven - Legacy)
# ------------------------------------------
backend/target/
backend/release/
backend/.mvn/
backend/*.jar
backend/*.war
backend/*.zip
backend/maven/
backend/mvnw.cmd
backend/mvnw
backend/logs/

# ------------------------------------------
# Frontend (React 19 + TypeScript + Vite)
# ------------------------------------------
frontend/node_modules/
node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
frontend/out/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/coverage/

# ------------------------------------------
# General Logs & Database Dumps
# ------------------------------------------
*.log
*.sql.bak
*.dump
*.db
*.sqlite
*.sqlite3
