# ==========================================
# LeadGrowth - Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Root, IDE & Editor Configurations
# ------------------------------------------
.idea/
.vscode/
*.suo
*.user
*.userprefs
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.swp
*~
.DS_Store
Thumbs.db
.vs/
_ReSharper*/
*.DotSettings.user

# Antigravity & Agent Temp Artifacts
.agents/
.gemini/
antigravity-ide/
scratch/

# ------------------------------------------
# Environment & Secrets Configuration (CRITICAL)
# ------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
*.env.local
*.env.*.local

# Frontend env files
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/.env.local
frontend/.env.*.local

# Backend env files
backend/.env
backend/.env.*
!backend/.env.example
backend-dotnet/.env
backend-dotnet/.env.*
!backend-dotnet/.env.example

# Keys, Certificates & Tokens
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.pkcs12
secrets.json
appsettings.secrets.json
**/UserSecrets/

# ------------------------------------------
# .NET 10 / C# Backend & API (backend-dotnet)
# ------------------------------------------
**/bin/
**/obj/
backend-dotnet/bin/
backend-dotnet/obj/
backend-dotnet/publish/
backend-dotnet/logs/
backend-dotnet/TestResults/
*.efbundle*

# Protect all backend appsettings & local developer configurations
appsettings*.json
!appsettings.example.json
backend-dotnet/appsettings*.json
!backend-dotnet/appsettings.example.json
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json
backend-dotnet/appsettings.Local.json

# Local API testing & HTTP client secrets
http-client.env.json
http-client.private.env.json
*.private.http
*.local.http

# ------------------------------------------
# User Uploads & Media (Avatars, Attachments)
# ------------------------------------------
backend-dotnet/wwwroot/uploads/*
!backend-dotnet/wwwroot/uploads/.gitkeep
backend-dotnet/wwwroot/uploads/avatars/*
!backend-dotnet/wwwroot/uploads/avatars/.gitkeep
wwwroot/uploads/*
!wwwroot/uploads/.gitkeep

# ------------------------------------------
# Backend (Java Spring Boot & Maven - Legacy)
# ------------------------------------------
backend/target/
backend/release/
backend/.mvn/
backend/*.jar
backend/*.war
backend/*.zip
backend/maven/
backend/mvnw.cmd
backend/mvnw
backend/logs/

# ------------------------------------------
# Frontend (React 19 + TypeScript + Vite)
# ------------------------------------------
frontend/node_modules/
node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
frontend/out/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/coverage/

# ------------------------------------------
# General Logs & Database Dumps
# ------------------------------------------
*.log
logs/
*.sql.bak
*.dump
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf
*.ndf
