# ==========================================
# LeadGrowth - Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Root & IDE Configurations
# ------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln.docstates
*.user
*.userosscache
*.swp
*~
.DS_Store
Thumbs.db
.vs/

# Antigravity & Agent Temp Artifacts
.agents/
.gemini/
antigravity-ide/
scratch/

# ------------------------------------------
# .NET 10 / C# Backend (backend-dotnet)
# ------------------------------------------
**/bin/
**/obj/
backend-dotnet/bin/
backend-dotnet/obj/
backend-dotnet/publish/
backend-dotnet/logs/
backend-dotnet/TestResults/
backend-dotnet/appsettings.*.json
backend-dotnet/appsettings.Development.json
backend-dotnet/appsettings.Local.json
!backend-dotnet/appsettings.json

# ------------------------------------------
# User Uploads & Media (Avatars, Attachments)
# ------------------------------------------
backend-dotnet/wwwroot/uploads/*
!backend-dotnet/wwwroot/uploads/.gitkeep
backend-dotnet/wwwroot/uploads/avatars/*
!backend-dotnet/wwwroot/uploads/avatars/.gitkeep

# ------------------------------------------
# Backend (Java Spring Boot & Maven - Legacy)
# ------------------------------------------
backend/target/
backend/release/
backend/.mvn/
backend/*.jar
backend/*.war
backend/*.zip
backend/maven/
backend/mvnw.cmd
backend/mvnw
backend/logs/

# ------------------------------------------
# Frontend (React 19 + TypeScript + Vite)
# ------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
frontend/out/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/coverage/

# ------------------------------------------
# Environment & Secrets Configuration
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local

# ------------------------------------------
# General Logs & Dumps
# ------------------------------------------
*.log
*.sql.bak
*.dump
